# Dev-only files that are not part of the deployed site.
# They stay in git, they just aren't uploaded to Vercel.

AGENTS.md
README.md
.git
.gitignore

# Social card source. The rendered og.png at the repo root is still deployed;
# only the HTML used to generate it is hidden.
og/

# Large original recordings. outputDirectory is the repo root, so these would
# otherwise ship alongside the site — only images/rem/web/ is deployed.
images/rem/masters/

# Build-time helper that produces images/rem/web/. Not part of the served site.
tools/

# NOTE: do not ignore package.json, package-lock.json, css/input.css,
# or tailwind.config.js — the Vercel build step needs all four to
# regenerate css/main.css from source.
